# Copy to .env and fill in values from Supabase → Project Settings → API.
# These are PUBLIC values protected by Row Level Security. Never add a
# service_role key, database password or AI provider token here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
